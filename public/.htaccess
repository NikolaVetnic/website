# Apache rules for the built site. `vite preview` serves pages the same way (see vite.config.ts).

DirectoryIndex index.html
Options -Indexes -MultiViews

RewriteEngine On

# Links to the old WordPress site (/?p=2074, /?page_id=7) go to their new pages, straight to https://. The same
# table is in app/wordpress-redirects.ts, which the browser uses while the hosting ignores this file; a test checks
# that both send every link to the same place. The trailing ? drops the old query string.
RewriteCond %{QUERY_STRING} (^|&)feed=
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/rss.xml? [R=301,L]

# Posts, then any other post id.
RewriteCond %{QUERY_STRING} (^|&)p=64(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/persepolis-gamma? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=71(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/svarun-divide-ut-regnes-2019-youtube? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=77(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/cakewalk-sonar-midi-controllers-rewired-to-max-msp? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=347(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/a-simple-feed-forward-image-classifier? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=362(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/convolution-neural-network-image-classifier? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=365(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/transfer-learning-finding-learning-rate-and-more? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=689(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/knossos-chapter-v-assets-completed? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1077(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/sights-of-chapter-vi? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1685(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/using-mylyn-3-23-with-eclipse-adt? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1700(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/consuming-a-rest-api-with-abap? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1739(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/sap-database-tables? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1742(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/sap-internal-tables? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1833(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/developing-a-slot-based-save-system-in-unity? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=1967(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/norsk-sprakkafe-i-novi-sad? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=2014(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/l-verb? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=2074(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog/pixel-perfect-text-in-unity? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=\d+(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog? [R=301,L]

# Pages, to the app of their section, then any other page id.
RewriteCond %{QUERY_STRING} (^|&)page_id=(7|1072|1508)(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/about? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=9(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=(298|505|895|1253|1371|1611|1614)(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/projects? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=(302|746|770|1413|1566|1571|1799)(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/games? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=296(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/art? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=(102|158|277|491|720|729|928|933|1103)(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/music? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=8(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/contact? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)page_id=\d+(&|$)
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/? [R=301,L]

# Category, tag, date and author archives.
RewriteCond %{QUERY_STRING} (^|&)(cat|tag|m|author)=
RewriteRule ^(index\.php)?$ https://%{HTTP_HOST}/blog? [R=301,L]

# HTTPS only. The forwarded header covers a proxy in front of Apache that talks to it over plain HTTP.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# A page's URL has no trailing slash (/blog), though its file is in a folder (blog/index.html). Apache's own
# redirect to /blog/ is off. /blog/ isn't redirected back either: LiteSpeed ignores DirectorySlash and adds the
# slash anyway, and the two redirects would loop. /blog/ serves the same page, the app drops the slash from the
# address (entry.client.tsx), and the canonical tag names /blog.
DirectorySlash Off

# Serve a page's folder at its URL, without a redirect.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Anything else without a file gets the SPA fallback, never another page's HTML: each page's HTML contains its
# own window, and hydrating it at the wrong URL leaves two desktops on the page. The 404 status stays.
ErrorDocument 404 /__spa-fallback.html

<IfModule mod_headers.c>
  # Pages and their .data files change with every deploy, so the browser checks for a new copy each time.
  # assets/ has its own .htaccess.
  Header set Cache-Control "no-cache"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml application/xml application/rss+xml image/svg+xml
</IfModule>

<Files "rss.xml">
  ForceType application/rss+xml
</Files>

# The deploy keeps a list of uploaded files next to the site; nobody else needs it.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
