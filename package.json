{
  "name": "website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "npm run build:games",
    "dev": "react-router dev",
    "prebuild": "npm run build:games",
    "build": "react-router build",
    "build:games": "vite build --config games/sodhara/vite.config.ts --logLevel warn && vite build --config games/knossos/vite.config.ts --logLevel warn",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:wordpress": "node scripts/import-wordpress.ts && prettier --write --log-level warn content"
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "isbot": "^5.2.2",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@react-router/dev": "^8.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turndown": "^7.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
